<idea-plugin package="dev.gipo.agentreview" require-restart="true">
    <id>dev.gipo.nitpick</id>
    <name>Nitpick</name>
    <vendor email="gipo18649ah@gmail.com" url="https://github.com/gipo355/intellij-nitpick">gipo355</vendor>
    <description><![CDATA[
        <p>Review code written by AI agents inside IntelliJ's diff viewer, then hand the review back to the agent.
        Works with Claude Code, Codex, OpenCode, Pi, GitHub Copilot Chat, JetBrains AI Assistant, and any MCP client.</p>

        <h3>Review like a pull request, locally</h3>
        <ul>
            <li>Pick what to review: uncommitted, staged, unstaged, a stash, a commit, a commit range, or everything since a branch's merge-base.</li>
            <li>No diff? <b>Current branch</b> lists the whole tree (or one folder). Click a file to open it in the editor and annotate it there: plan a refactor on main, hand the notes to the agent.</li>
            <li>Comment on a line, a selection, or a whole file. Hover a line and click <b>+</b> in the gutter, or press <b>Alt+Shift+C</b>.</li>
            <li>Comments render inline under the code with Edit, Resolve, and Delete. Types: note, issue, question, nit, praise.</li>
            <li>Mark files reviewed. Marks are keyed by content, so a file the agent touches again shows up as changed.</li>
            <li>Next Unreviewed walks you through what is left.</li>
        </ul>

        <h3>Send the review to any agent</h3>
        <ul>
            <li><b>Clipboard</b>: tuicr-compatible Markdown with <code>path:line</code> references and code snippets.</li>
            <li><b>Terminal</b>: paste straight into the IDE terminal tab running claude, codex, opencode, or pi.</li>
            <li><b>File</b>: write <code>.agent-review/REVIEW.md</code> and <code>REVIEW.json</code> for the agent to read.</li>
            <li><b>GitHub Copilot Chat</b> and <b>JetBrains AI Assistant</b>: open a chat with the review as the prompt.</li>
            <li><b>MCP</b>: tools on IntelliJ's built-in MCP server. The agent pulls comments, resolves them with a reply, and can ask you questions back.</li>
        </ul>

        <p>Git Log integration: right-click one commit, or Ctrl+click several and review them as a range.</p>
    ]]></description>

    <dependencies>
        <plugin id="Git4Idea"/>
    </dependencies>
    <content>
        <module name="dev.gipo.agentreview.terminal"/>
        <module name="dev.gipo.agentreview.mcp"/>
    </content>

    <extensions defaultExtensionNs="com.intellij">
        <projectService serviceImplementation="dev.gipo.agentreview.store.ReviewStore"/>
        <applicationService serviceImplementation="dev.gipo.agentreview.settings.AgentReviewSettings"/>
        <applicationConfigurable parentId="tools" instance="dev.gipo.agentreview.settings.AgentReviewConfigurable"
                                 id="dev.gipo.agentreview.settings" displayName="Nitpick"/>

        <toolWindow id="Nitpick" anchor="right" icon="/icons/toolWindowNitpick.svg" secondary="false"
                    factoryClass="dev.gipo.agentreview.ui.ReviewToolWindowFactory"/>

        <diff.DiffExtension implementation="dev.gipo.agentreview.diff.ReviewDiffExtension"/>
        <!-- Branch mode only: comments in regular editors, torn down when the scope changes. -->
        <editorFactoryListener implementation="dev.gipo.agentreview.diff.BranchEditorBinder$Listener"/>

        <vcs.changes.changesViewNodeAction implementation="dev.gipo.agentreview.ui.ReviewedHoverAction"/>

        <notificationGroup id="Nitpick" displayType="BALLOON"/>
    </extensions>

    <actions>
        <!-- Diff viewers and editors: the three groups below vanish as a whole while Editor Annotations is off. -->
        <group id="AgentReview.DiffActions" class="dev.gipo.agentreview.actions.AnnotationsGroup">
            <action id="AgentReview.AddComment" class="dev.gipo.agentreview.actions.AddCommentAction"
                    text="Add Review Comment" description="Comment on the selected lines" icon="AllIcons.Toolwindows.ToolWindowMessages">
                <keyboard-shortcut keymap="$default" first-keystroke="alt shift C"/>
            </action>
            <action id="AgentReview.AddFileComment" class="dev.gipo.agentreview.actions.AddFileCommentAction"
                    text="Add File Comment" description="Comment on the whole file" icon="AllIcons.FileTypes.Text">
                <keyboard-shortcut keymap="$default" first-keystroke="alt shift F"/>
            </action>
            <action id="AgentReview.AddFolderComment" class="dev.gipo.agentreview.actions.AddFolderCommentAction"
                    text="Add Folder Comment…" description="Comment on every file under this folder" icon="AllIcons.Nodes.Folder"/>
            <group id="AgentReview.EditFileComments" class="dev.gipo.agentreview.actions.EditFileCommentsGroup"
                   text="Edit Comment" popup="true"/>
            <action id="AgentReview.ToggleReviewed" class="dev.gipo.agentreview.actions.ToggleReviewedAction"
                    text="Toggle File Reviewed" description="Mark or unmark this file as reviewed" icon="AllIcons.Actions.Checked">
                <keyboard-shortcut keymap="$default" first-keystroke="alt shift R"/>
            </action>
            <action id="AgentReview.PrevUnreviewed" class="dev.gipo.agentreview.actions.PrevUnreviewedAction"
                    text="Previous Unreviewed File" description="Open the diff of the previous unreviewed file" icon="AllIcons.Actions.PreviousOccurence">
                <keyboard-shortcut keymap="$default" first-keystroke="alt shift P"/>
            </action>
            <action id="AgentReview.NextUnreviewed" class="dev.gipo.agentreview.actions.NextUnreviewedAction"
                    text="Next Unreviewed File" description="Open the diff of the next unreviewed file" icon="AllIcons.Actions.NextOccurence">
                <keyboard-shortcut keymap="$default" first-keystroke="alt shift N"/>
            </action>
            <add-to-group group-id="Diff.EditorPopupMenu" anchor="first"/>
            <add-to-group group-id="Diff.KeymapGroup" anchor="last"/>
        </group>

        <!-- Regular editors: every entry hides itself unless the editor is bound (branch mode). -->
        <group id="AgentReview.EditorPopup" class="dev.gipo.agentreview.actions.AnnotationsGroup">
            <reference ref="AgentReview.AddComment"/>
            <reference ref="AgentReview.AddFileComment"/>
            <reference ref="AgentReview.EditFileComments"/>
            <reference ref="AgentReview.ToggleReviewed"/>
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </group>

        <group id="AgentReview.SendGroup" text="Send Review To" popup="true" icon="AllIcons.Actions.Upload">
            <action id="AgentReview.CopyMarkdown" class="dev.gipo.agentreview.actions.CopyReviewAction"
                    text="Copy Review to Clipboard" icon="AllIcons.Actions.Copy">
                <keyboard-shortcut keymap="$default" first-keystroke="alt shift Y"/>
            </action>
            <action id="AgentReview.SendToTerminal" class="dev.gipo.agentreview.actions.SendToTerminalAction"
                    text="Send to Terminal Agent" description="Paste the review into a terminal tab (claude, codex, opencode, pi…)"
                    icon="AllIcons.Nodes.Console"/>
            <action id="AgentReview.SendToCopilot" class="dev.gipo.agentreview.actions.SendToCopilotAction"
                    text="Send to GitHub Copilot Chat"/>
            <action id="AgentReview.SendToAiAssistant" class="dev.gipo.agentreview.actions.SendToAiAssistantAction"
                    text="Send to JetBrains AI Assistant"/>
            <action id="AgentReview.WriteFile" class="dev.gipo.agentreview.actions.WriteReviewFileAction"
                    text="Write Review File" description="Write the review Markdown to the configured file" icon="AllIcons.Actions.MenuSaveall"/>
            <add-to-group group-id="AgentReview.DiffActions" anchor="last"/>
        </group>

        <group id="AgentReview.DiffToolbar" class="dev.gipo.agentreview.actions.AnnotationsGroup">
            <reference ref="AgentReview.ToggleReviewed"/>
            <reference ref="AgentReview.AddComment"/>
            <reference ref="AgentReview.AddFileComment"/>
            <reference ref="AgentReview.PrevUnreviewed"/>
            <reference ref="AgentReview.NextUnreviewed"/>
            <reference ref="AgentReview.SendGroup"/>
            <add-to-group group-id="Diff.ViewerToolbar" anchor="last"/>
        </group>

        <group id="AgentReview.TreePopup">
            <reference ref="AgentReview.ToggleReviewed"/>
            <reference ref="AgentReview.AddFileComment"/>
            <reference ref="AgentReview.AddFolderComment"/>
            <reference ref="AgentReview.EditFileComments"/>
        </group>

        <action id="AgentReview.ReviewCommit" class="dev.gipo.agentreview.actions.ReviewCommitAction"
                text="Review Commit with Nitpick" icon="/icons/toolWindowNitpick.svg">
            <add-to-group group-id="Vcs.Log.ContextMenu" anchor="last"/>
        </action>
        <action id="AgentReview.ReviewUncommitted" class="dev.gipo.agentreview.actions.ReviewUncommittedAction"
                text="Review Uncommitted Changes with Nitpick" icon="/icons/toolWindowNitpick.svg">
            <add-to-group group-id="ChangesViewPopupMenu" anchor="last"/>
            <add-to-group group-id="Git.Menu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
